# ==============================================================================
# PulseDash Environment Configuration
# ==============================================================================
# Copy this file to .env.local to configure your environment:
#   cp .env.example .env.local
#
# IMPORTANT SECURITY NOTICE:
# - All API secrets are strictly server-side.
# - NEVER prefix upstream provider keys with NEXT_PUBLIC_.
# - NEVER commit .env.local to version control.
# ==============================================================================

# News API Configuration (NewsAPI.org)
# Register for a free API key at: https://newsapi.org/register
# Free developer tier allows requests from localhost.
NEWS_API_KEY=your_news_api_key_here

# TMDB API Configuration (The Movie Database)
# Register and generate an API key at: https://www.themoviedb.org/settings/api
# Used for movie genre discovery, trending recommendations, and search.
TMDB_API_KEY=your_tmdb_api_key_here

# Optional: TMDB Read Access Token (v4 Bearer token) if preferred over v3 API key
# TMDB_ACCESS_TOKEN=your_v4_bearer_token_here

# Force Demo Mode (true/false)
# Set to 'true' to explicitly run with typed demo fixtures even if keys are provided.
# If keys are omitted or left as placeholders, demo mode activates automatically
# with clear "Demo Data" indicators in the UI.
DEMO_MODE=false
